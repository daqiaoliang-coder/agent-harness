{
  "name": "agent-harness",
  "version": "0.1.0",
  "description": "AI coding agent harness — 参考架构实现的最小骨架",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "lint": "eslint src test",
    "demo": "tsc && node dist/cli.js demo",
    "chat": "tsc && node dist/cli.js chat",
    "web": "tsc && node dist/cli.js web",
    "smoke": "tsc && node test/smoke.js",
    "smoke:web": "tsc && node test/web-smoke.js"
  },
  "bin": {
    "agent-harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.12.0",
    "typescript": "5.6",
    "typescript-eslint": "^8.71.0"
  }
}
